# ─────────────────────────────────────────────────────────────
# BioFitCoach — Environment Variables
# Copy this file to .env and fill in your actual values.
# Your .env is already in .gitignore — never commit secrets.
# ─────────────────────────────────────────────────────────────

# ── Database (your existing connection string) ────────────────
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/Biomechanics_AI

# ── OpenAI (your existing key) ───────────────────────────────
OPENAI_API_KEY=sk-...

# ── Module 2 — ML model paths ────────────────────────────────
# These point to your trained notebook artifacts.
# Default values match ml_models/ in your project root.
GRU_MODEL_PATH=ml_models/gru_model.keras
SCALER_PATH=ml_models/scaler.pkl
LABEL_MAPPING_PATH=ml_models/label_mapping.json

# ── Module 2 — Inference ──────────────────────────────────────
CONFIDENCE_THRESHOLD=0.70
SEQUENCE_LENGTH=30

# ── App ───────────────────────────────────────────────────────
APP_NAME=BioFitCoach API
APP_VERSION=1.0.0
DEBUG=False