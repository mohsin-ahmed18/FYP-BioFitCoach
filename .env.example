# 1) Copy this file to .env (same folder as main.py).
# 2) Replace YOUR_PASSWORD with the same password pgAdmin uses for user "postgres"
#    (Server → right-click PostgreSQL → Properties → Connection).
# 3) Create database "Biomechanics_AI" if it does not exist.
#
# First-time DB tables:  python database.py init
# Verify connection:      python database.py check
# Start API + DB check:   python database.py serve   OR   .\run_api.ps1
#
# If the password contains @ # : / ? or spaces, URL-encode it (e.g. @ → %40).
#
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@127.0.0.1:5432/Biomechanics_AI
